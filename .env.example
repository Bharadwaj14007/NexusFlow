# PostgreSQL connection used by Prisma
# Local (docker compose): postgresql://nexusflow:nexusflow@localhost:5432/nexusflow?schema=public
DATABASE_URL="postgresql://nexusflow:nexusflow@localhost:5432/nexusflow?schema=public"

# Optional legacy secret; current auth uses random database-backed opaque sessions, not signed cookies.
AUTH_SECRET="replace-with-a-long-random-string"

# Bearer token required by GET /api/cron/workflows
WORKFLOW_CRON_SECRET="replace-with-a-long-random-cron-secret"

# Server-side AI and optional provider configuration
OPENAI_API_KEY="replace-with-an-openai-api-key"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Optional email provider used for invitations and workflow email actions
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NexusFlow <noreply@example.com>"

# Optional Cloudinary credentials for storing original document uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Razorpay test-mode credentials
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PRO_PLAN_ID=""
RAZORPAY_ENTERPRISE_PLAN_ID=""

# 32+ character key used to encrypt credentials for external integrations
INTEGRATION_ENCRYPTION_KEY=""

# OAuth applications for supported integrations (each provider is optional)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""

# Optional error monitoring
SENTRY_DSN=""

# Optional public application origin used in invitation email links
APP_URL="http://localhost:3000"
